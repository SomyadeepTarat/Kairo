# Local development only. The application reads the environment, not this file automatically.
KAIRO_DATABASE_URL=postgresql+psycopg://kairo:kairo_local_only@127.0.0.1:55432/kairo
# Integration tests create/drop their own unique schema in this disposable local DB.
KAIRO_TEST_DATABASE_URL=postgresql+psycopg://kairo:kairo_local_only@127.0.0.1:55432/kairo

# Enable actual sandbox/worker integration tests after building kairo-sandbox:local.
KAIRO_TEST_DOCKER=1
# Optional full repository check (requires npm ci in apps/web).
KAIRO_CHECK_WEB=1
# scripts/serve.py enables this by default; 0 leaves worker ownership to demo driver.
KAIRO_EMBEDDED_WORKER=1
KAIRO_WORKSPACE_ROOT=.kairo/workspaces
# Disable optional Next.js anonymous telemetry for local-only development.
NEXT_TELEMETRY_DISABLED=1
